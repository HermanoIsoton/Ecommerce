FROM php:8.4-cli-trixie

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

RUN apt-get update && apt-get install -y --no-install-recommends \
        libzip-dev \
    && docker-php-ext-install pdo_mysql zip bcmath \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY . .


RUN composer validate --no-check-publish \
    && composer install --no-interaction --prefer-dist \
    && composer check-platform-reqs

EXPOSE 8000


CMD ["sh", "-c", "set -e; if [ ! -f .env ]; then cp .env.example .env; fi; if ! grep -q '^APP_KEY=.' .env; then php artisan key:generate --no-interaction; fi; php artisan migrate --no-interaction; exec php artisan serve --host=0.0.0.0 --no-reload"]